# ============================================================
#  NEWS VIDEO PIPELINE — ENVIRONMENT CONFIGURATION TEMPLATE
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ============================================================

# ── PIPELINE MODE ────────────────────────────────────────────
# true = skip enrichment, publishing, scheduling (faster dev loop)
MVP_MODE=true

# ── INGESTION ────────────────────────────────────────────────
# Comma-separated list: gdelt, rss, newsapi
INGESTORS=gdelt,rss

# NewsAPI (https://newsapi.org — free tier: 100 req/day)
NEWSAPI_KEY=your_newsapi_key_here

# RSS feed URLs — pipe-separated list
RSS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml|https://rss.cnn.com/rss/edition.rss|https://feeds.reuters.com/reuters/topNews

# Time window for article ingestion (hours)
INGEST_LOOKBACK_HOURS=6

# Max articles to fetch per ingestor run
INGEST_MAX_ARTICLES=500

# ── EMBEDDING ────────────────────────────────────────────────
# Provider: local | openai
EMBEDDING__PROVIDER=local

# Local sentence-transformers model name (downloaded automatically)
EMBEDDING__LOCAL_MODEL=all-MiniLM-L6-v2

# OpenAI (only needed if EMBEDDING__PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING__OPENAI_MODEL=text-embedding-3-small
EMBEDDING__OPENAI_BATCH_SIZE=100

# ── CLUSTERING ───────────────────────────────────────────────
# Cosine similarity threshold (0.0–1.0; higher = tighter clusters)
CLUSTERING__THRESHOLD=0.80
# Minimum articles to form a cluster
CLUSTERING__MIN_CLUSTER_SIZE=2
# Maximum clusters to carry forward to ranking
CLUSTERING__MAX_CLUSTERS=50

# ── ENRICHMENT (non-MVP) ─────────────────────────────────────
ENRICHMENT__ENABLED=false
ENRICHMENT__SPACY_MODEL=en_core_web_sm

# ── RANKING ──────────────────────────────────────────────────
# Number of top stories to generate scripts for
RANKING__TOP_N=5
# Time decay half-life in hours (older stories lose weight)
RANKING__DECAY_HALF_LIFE_HOURS=12
# Scoring weights (must sum to 1.0)
RANKING__WEIGHT_COVERAGE=0.30
RANKING__WEIGHT_DIVERSITY=0.20
RANKING__WEIGHT_VELOCITY=0.20
RANKING__WEIGHT_ENTITY=0.20
RANKING__WEIGHT_LLM=0.10

# ── LLM (script generation & enrichment summarizer) ──────────
# Provider: openai | ollama
LLM__PROVIDER=ollama

# OpenAI settings
LLM__OPENAI_MODEL=gpt-4o
LLM__OPENAI_MAX_TOKENS=600
LLM__OPENAI_TEMPERATURE=0.7

# Ollama settings (local; run `ollama serve` first)
LLM__OLLAMA_BASE_URL=http://localhost:11434
LLM__OLLAMA_MODEL=llama3:8b
LLM__OLLAMA_MAX_TOKENS=600
LLM__OLLAMA_TEMPERATURE=0.7

# ── TTS ──────────────────────────────────────────────────────
# Provider: kokoro | fishaudio | piper | coqui | elevenlabs
TTS__PROVIDER=kokoro

# ── Kokoro TTS (local, Python 3.12 compatible) ───────────────
# Models download automatically on first run (~300 MB)
# lang: 'a' = American English, 'b' = British English
TTS__KOKORO_LANG=a
#
# Pick a default voice. All tones fall back to this if not individually set.
# American female: af_heart  af_bella  af_nicole  af_nova  af_sky  af_river
# American male:   am_adam   am_michael am_onyx   am_echo  am_liam am_puck
# British female:  bf_emma   bf_isabella bf_alice
# British male:    bm_george bm_lewis   bm_daniel
TTS__KOKORO_DEFAULT_VOICE=af_nova
#
# Optional: different voice per tone (leave blank to use DEFAULT_VOICE)
TTS__KOKORO_VOICE_NEUTRAL=
TTS__KOKORO_VOICE_SERIOUS=
TTS__KOKORO_VOICE_URGENT=
TTS__KOKORO_VOICE_ANALYTICAL=
#
# Optional: speed per tone (1.0 = normal; >1.0 = faster; <1.0 = slower)
# Defaults if blank: neutral=1.0  serious=0.92  urgent=1.1  analytical=0.95
TTS__KOKORO_SPEED_NEUTRAL=
TTS__KOKORO_SPEED_SERIOUS=
TTS__KOKORO_SPEED_URGENT=
TTS__KOKORO_SPEED_ANALYTICAL=

# Piper TTS (local fallback — no API key needed)
# Download binary + models from https://github.com/rhasspy/piper/releases
TTS__PIPER_EXECUTABLE=piper
TTS__PIPER_MODEL=en_US-lessac-medium
TTS__PIPER_MODELS_DIR=./models/piper

# Coqui XTTS-v2 (local GPU — model downloads automatically on first run, ~2 GB)
TTS__COQUI_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
TTS__COQUI_LANGUAGE=en
#
# Reference audio for voice cloning — 6 to 30 seconds, clean WAV, no background noise.
# One clip per tone. Any tone without a specific clip falls back to DEFAULT_REF_AUDIO.
# Minimum: just set DEFAULT_REF_AUDIO and all tones will use that voice.
TTS__COQUI_DEFAULT_REF_AUDIO=./voices/anchor_neutral.wav
TTS__COQUI_REF_AUDIO_NEUTRAL=
TTS__COQUI_REF_AUDIO_SERIOUS=
TTS__COQUI_REF_AUDIO_URGENT=
TTS__COQUI_REF_AUDIO_ANALYTICAL=

# ElevenLabs (paid API — https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
TTS__ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
TTS__ELEVENLABS_MODEL=eleven_multilingual_v2

# ── VIDEO ────────────────────────────────────────────────────
# Provider: wav2lip | sadtalker | static (fallback: audio + static image)
VIDEO__PROVIDER=static

# Paths to cloned Wav2Lip / SadTalker repos (if using those providers)
WAV2LIP_REPO_PATH=./external/Wav2Lip
SADTALKER_REPO_PATH=./external/SadTalker

# Default anchor image for video generation
VIDEO__ANCHOR_IMAGE=./video/assets/anchor_photo.jpg
VIDEO__LOGO_PATH=./video/assets/logo.png

# Output resolution (9:16 vertical for shorts)
VIDEO__WIDTH=1080
VIDEO__HEIGHT=1920
VIDEO__FPS=30
VIDEO__OUTPUT_DIR=./output/videos

# B-roll stock footage APIs (optional)
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# ── STORAGE ──────────────────────────────────────────────────
# Provider: sqlite | postgres
STORAGE__PROVIDER=sqlite
STORAGE__SQLITE_PATH=./data/news_pipeline.db

# PostgreSQL (only needed if STORAGE__PROVIDER=postgres)
STORAGE__POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/news_pipeline

# ── PUBLISHING (non-MVP) ─────────────────────────────────────
# Comma-separated: youtube, instagram, tiktok
PUBLISHERS=

# YouTube OAuth2 credentials (download from Google Cloud Console)
YOUTUBE_CLIENT_SECRETS_FILE=./credentials/youtube_client_secrets.json
YOUTUBE_TOKEN_FILE=./credentials/youtube_token.json
YOUTUBE_DEFAULT_PRIVACY=private

# Instagram credentials
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
INSTAGRAM_SESSION_FILE=./credentials/instagram_session.json

# TikTok credentials
TIKTOK_SESSION_ID=your_tiktok_session_id

# ── SCHEDULING (non-MVP) ─────────────────────────────────────
# Ingestion cron expression (default: every 30 minutes)
SCHEDULE__INGEST_CRON=*/30 * * * *
# Pipeline trigger: how many minutes after ingest to run downstream stages
SCHEDULE__PIPELINE_DELAY_MINUTES=2
# Publishing cron (default: 4× per day)
SCHEDULE__PUBLISH_CRON=0 8,12,17,21 * * *

# ── HARDWARE ─────────────────────────────────────────────────
# Force CPU even if CUDA is available (useful for debugging)
FORCE_CPU=false
# Max VRAM to allocate per model (GB); leave blank for auto-detection
MAX_VRAM_GB=
